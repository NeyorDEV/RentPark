@using System.Globalization
@using MudBlazor
@inject NavigationManager NavigationManager

<MudSelect T="string"
           Label="Langue"
           Variant="Variant.Outlined"
           Dense="true"
           @bind-Value="SelectedCultureName"
           Class="ml-2"
           Style="min-width:150px;">
    @foreach (var c in SupportedCultures)
    {
        <MudSelectItem Value="@c.Name">@c.DisplayName</MudSelectItem>
    }
</MudSelect>

