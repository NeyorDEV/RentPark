@using Microsoft.Extensions.Localization
@using MudBlazor
@inherits MudComponentBase

<MudNavMenu Bordered="true" Class="mud-width-full py-4 d-flex flex-column h-100">
    @* Conteneur pour les liens du haut *@
    <div class="flex-grow-1">
        <MudNavLink Href="" Match="NavLinkMatch.All"
                    Icon="@Icons.Material.Filled.Home"
                    IconColor="Color.Primary"
                    Class="nav-item-custom">
            [cite_start]<MudText Typo="Typo.button" Style="font-weight: 600;">@Localizer["Home"]</MudText> [cite: 2]
        </MudNavLink>

        <MudNavLink Href="account"
                    Icon="@Icons.Material.Filled.Person"
                    IconColor="Color.Primary"
                    Class="nav-item-custom">
            [cite_start]<MudText Typo="Typo.button" Style="font-weight: 600;">@Localizer["Account"]</MudText> [cite: 3]
        </MudNavLink>

        <MudNavLink Href="cars"
                    Icon="@Icons.Material.Filled.CarRental"
                    IconColor="Color.Primary"
                    Class="nav-item-custom">
            <MudText Typo="Typo.button" Style="font-weight: 600;">@Localizer["Flotte"]</MudText>
            [cite_start]
        </MudNavLink> [cite: 4]
    </div>

    @* Le sélecteur sera poussé vers le bas *@
    <div class="mt-auto pa-4">
        <CultureSelector />
    </div>
</MudNavMenu>

<style>
    .nav-item-custom {
        margin: 4px 8px;
        [cite_start]border-radius: 8px;
        [cite: 6]
    }

    .mud-nav-link.active {
        background-color: var(--mud-palette-primary-hover) !important;
        [cite_start]color: var(--mud-palette-primary) !important;
        [cite: 7]
    }
</style>