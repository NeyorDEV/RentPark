@using MudBlazor

<MudNavMenu Bordered="true" Class="mud-width-full py-4">

    <MudNavLink Href="" Match="NavLinkMatch.All"
                Icon="@Icons.Material.Filled.Home"
                IconColor="Color.Primary"
                Class="nav-item-custom">
        <MudText Typo="Typo.button" Style="font-weight: 600;">Accueil</MudText>
    </MudNavLink>

    <MudNavLink Href="account"
                Icon="@Icons.Material.Filled.Person"
                IconColor="Color.Info"
                Class="nav-item-custom">
        <MudText Typo="Typo.button" Style="font-weight: 600;">Compte</MudText>
    </MudNavLink>

    <MudNavLink Href="cars"
                Icon="@Icons.Material.Filled.CarRental"
                IconColor="Color.Info"
                Class="nav-item-custom">
        <MudText Typo="Typo.button" Style="font-weight: 600;">Ma flotte</MudText>
    </MudNavLink>

</MudNavMenu>

<style>
    .nav-item-custom {
        margin: 4px 8px;
        border-radius: 8px;
    }

    .mud-nav-link.active {
        background-color: var(--mud-palette-primary-hover) !important;
        color: var(--mud-palette-primary) !important;
    }
</style>