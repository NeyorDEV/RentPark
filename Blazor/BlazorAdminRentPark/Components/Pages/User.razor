@page "/users"

<h3>Liste des Utilisateurs</h3>

<button class="btn btn-success mb-3" @onclick="NavigateToAddUser">
    Ajouter un utilisateur
</button>

@if (users == null)
{
    <p><em>Chargement...</em></p>
}
else if (!users.Any())
{
    <p><em>Aucun utilisateur trouvé.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>IdClient</th>
                <th>Password</th>
                <th>Nom d'utilisateur</th>
                <th>Rôle</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in users)
            {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Password</td>  
                    <td>@user.Username</td>
                    <td>@user.Role</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteUser(user.Id)">
                            Supprimer
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}