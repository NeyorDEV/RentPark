@page "/account"
@rendermode InteractiveServer
@using MudBlazor
@inject IDialogService DialogService

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold;">Compte</MudText>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Success"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddUserDialog">
            AJOUTER
        </MudButton>
    </MudStack>

    @* Barre de recherche *@
    <MudTextField @bind-Value="SearchString" 
                  Placeholder="Rechercher..."
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-4">
        <MudText Typo="Typo.subtitle2" Class="mr-4">Afficher par page :</MudText>
        <MudSelect T="int" @bind-Value="PageSize" Dense="true" Style="width:90px;">
            <MudSelectItem Value="4">4</MudSelectItem>
            <MudSelectItem Value="8">8</MudSelectItem>
            <MudSelectItem Value="12">12</MudSelectItem>
        </MudSelect>
    </MudStack>
     
    <MudGrid>
        @foreach (var user in PagedUsers)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 text-center">
                    <MudText Typo="Typo.h6">@user.Id</MudText>
                    <MudText Typo="Typo.body1">@user.Username</MudText>
                    <MudText Typo="Typo.caption">@user.Role</MudText>
                    <div class="d-flex justify-center my-4">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="font-size: 6rem;" />
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               Class="mb-2"
                               OnClick="@(() => DeleteUser(user.Id))">
                        SUPPRIMER
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Style="background-color: #f44336; color: white;"
                               FullWidth="true"
                               OnClick="@(() => EditUser(user.Id))">
                        MODIFIER
                    </MudButton>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    @* Pagination control *@
    <MudStack Row="true" Justify="Justify.Center" Class="mt-6">
        <MudPagination Selected="@_currentPage" SelectedChanged="OnPageChanged" Count="@PageCount" />
    </MudStack>
</MudContainer>