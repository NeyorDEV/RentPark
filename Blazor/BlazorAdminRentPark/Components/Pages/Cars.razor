@page "/cars"
@rendermode InteractiveServer
@using MudBlazor
@using BlazorAdminRentPark.Models

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">

        <MudText Typo="Typo.h4" Style="font-weight: bold;">@Localizer["Vehicules"]</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddCarDialog">
            @Localizer["Add"]

        </MudButton>
    </MudStack>

    <MudTextField @bind-Value="SearchString"
                  Placeholder="@Localizer["Search"]"
                  Adornment="Adornment.End"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Class="mb-4" />

    <MudStack Row="true" Justify="Justify.FlexEnd" Class="mb-4">
        <MudText Typo="Typo.subtitle2" Class="mr-4">@Localizer["PageSizeLabel"]</MudText>
        <MudSelect T="int" @bind-Value="PageSize" Dense="true" Style="width:90px;">
            <MudSelectItem Value="4">4</MudSelectItem>
            <MudSelectItem Value="8">8</MudSelectItem>
            <MudSelectItem Value="12">12</MudSelectItem>
        </MudSelect>
    </MudStack>

    <MudGrid>
        @foreach (var car in PagedCars)
        {
            <MudItem xs="12" sm="6" md="3">
                <MudCard Elevation="2" Class="pa-4 text-center">
                    @if (!string.IsNullOrEmpty(car.ImagePath))
                    {
                        <MudImage Src="@car.ImagePath" Alt="Top Car" Elevation="0" ObjectFit="ObjectFit.Contain" Height="80" Class="mb-2" />
                    }

                    <MudText Typo="Typo.h6" Style="font-weight:bold;">@car.Nom</MudText>
                    <MudText Typo="Typo.body2">@car.Marque - @car.Categorie</MudText>
                    <MudText Typo="Typo.caption" Class="mb-4 d-block">Série: @car.NumSerie</MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Error"
                               FullWidth="true"
                               Class="mb-2"
                               OnClick="@(() => DeleteCar(car.NumSerie))">
                        @Localizer["Delete"]
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               Style="background-color: #f44336; color: white;"
                               FullWidth="true"
                               OnClick="@(() => OpenEditCarDialog(car))">
                        @Localizer["Edit"]
                    </MudButton>
                </MudCard>
            </MudItem>
        }
    </MudGrid>

    <MudStack Row="true" Justify="Justify.Center" Class="mt-6"> 
        <MudPagination Page="@CurrentPage" PageCount="@PageCount" OnPageChanged="OnPageChanged" />
    </MudStack>
</MudContainer>