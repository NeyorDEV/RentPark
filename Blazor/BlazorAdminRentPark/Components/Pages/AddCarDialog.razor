@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]  

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">@Localizer["Add"]</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="4" Class="pa-4">
                @* Informations de base *@
                <MudTextField @bind-Value="_vehiculeModel.NumSerie" 
                              Label="@Localizer["numSerie"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["numSerieObligatoire"]" />

                <MudTextField @bind-Value="_vehiculeModel.Nom"
                              Label="@Localizer["Nom"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["NomObligatoire"]" />

                <MudTextField @bind-Value="_vehiculeModel.Marque"
                              Label="@Localizer["Marque"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["MarqueObligatoire"]" />

                <MudTextField @bind-Value="_vehiculeModel.Annee"
                              Label="@Localizer["Annee"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["AnneeObligatoire"]" />

                <MudTextField @bind-Value="_vehiculeModel.Couleur"
                              Label="@Localizer["Couleur"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["CouleurObligatoire"]" />

                @* Catégorie et caractéristiques *@
                <MudTextField @bind-Value="_vehiculeModel.Categorie"
                              Label="@Localizer["Categorie"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["CategorieObligatoire"]" />

                <MudNumericField @bind-Value="_vehiculeModel.NbPlaces"
                                 Label="@Localizer["NbPlace"]"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Required="true"
                                 RequiredError="@Localizer["NbPlaceObligatoire"]" />

                <MudSelect @bind-Value="_vehiculeModel.Energie"
                           Label="@Localizer["Energie"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="@Localizer["EnergieObligatoire"]">
                    <MudSelectItem Value="@("Hybride")">@Localizer["Hybride"]</MudSelectItem>
                    <MudSelectItem Value="@("Électrique")">@Localizer["Electrique"]</MudSelectItem>
                    <MudSelectItem Value="@("Essence")">@Localizer["Essence"]</MudSelectItem>
                    <MudSelectItem Value="@("Diesel")">@Localizer["Diesel"]</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_vehiculeModel.Transmission"
                           Label="@Localizer["Transmission"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="@Localizer["TransmissionObligatoire"]">
                    <MudSelectItem Value="@("Propulsion")">@Localizer["Propulsion"]</MudSelectItem>
                    <MudSelectItem Value="@("Traction")">@Localizer["Traction"]</MudSelectItem>
                    <MudSelectItem Value="@("Intégrale")">@Localizer["Integrale"]</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_vehiculeModel.Boite"
                           Label="@Localizer["BoiteVitesse"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="@Localizer["BoiteVitesseObligatoire"]">
                    <MudSelectItem Value="@("Manuelle")">@Localizer["Manuelle"]</MudSelectItem>
                    <MudSelectItem Value="@("Automatique")">@Localizer["Automatique"]</MudSelectItem>
                </MudSelect>

                <MudTextField @bind-Value="_vehiculeModel.Puissance"
                              Label="@Localizer["Puissance"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["PuissanceObligatoire"]" />

                @* État et Prix *@
                <MudSelect @bind-Value="_vehiculeModel.Etat"
                           Label="@Localizer["Etat"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="@Localizer["EtatObligatoire"]">
                    <MudSelectItem Value="@("Libre")">@Localizer["Libre"]</MudSelectItem>
                    <MudSelectItem Value="@("Louée")">@Localizer["Louee"]</MudSelectItem>
                    <MudSelectItem Value="@("Vendue")">@Localizer["Vendue"]</MudSelectItem>
                    <MudSelectItem Value="@("Réparation")">@Localizer["Reparation"]</MudSelectItem>
                </MudSelect>

                <MudNumericField @bind-Value="_vehiculeModel.Prix"
                                 Label="@Localizer["Prix"]"
                                 Variant="Variant.Outlined"
                                 Adornment="Adornment.Start"
                                 AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                 Min="0"
                                 Required="true"
                                 RequiredError="@Localizer["PrixObligatoire"]" />

                @* IDs *@
                <MudNumericField @bind-Value="_vehiculeModel.IdAssureur"
                                 Label="@Localizer["IdAssureur"]"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Required="true"
                                 RequiredError="@Localizer["IdAssureurObligatoire"]" />

                <MudNumericField @bind-Value="_vehiculeModel.IdFournisseur"
                                 Label="@Localizer["IdFournisseur"]"
                                 Variant="Variant.Outlined"
                                 Min="0"
                                 Required="true"
                                 RequiredError="@Localizer["IdFournisseurObligatoire"]" />

                <MudTextField @bind-Value="_vehiculeModel.ImagePath"
                              Label="@Localizer["CheminImage"]"
                              Variant="Variant.Outlined" />

                @* Dates *@
                <MudDatePicker Label="@Localizer["DateAchat"]"
                               @bind-Value="_vehiculeModel.DateAchat"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="@Localizer["DateAchatObligatoire"]" />

                <MudDatePicker Label="@Localizer["DernierControle"]"
                               @bind-Value="_vehiculeModel.DateDernierControleTech"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="@Localizer["DernierControleObligatoire"]" />

                <MudDatePicker Label="@Localizer["ExpirationControle"]"
                               @bind-Value="_vehiculeModel.DateExpirationControleTech"
                               Variant="Variant.Outlined"
                               Required="true"
                               RequiredError="@Localizer["ExpirationControleObligatoire"]" />
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="HandleSubmit"
                   FullWidth="true"
                   Style="max-width: 200px; margin: 0 auto 20px auto;"
                   Disabled="@(!_isValid)">
            @Localizer["Ajouter"]
        </MudButton>
    </DialogActions>
</MudDialog>
