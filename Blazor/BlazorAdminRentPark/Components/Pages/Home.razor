@page "/"
@using MudBlazor
@using MAlign = MudBlazor.Align

@using BlazorAdminRentPark.Models
@using BlazorAdminRentPark.Services
@inject IDashboardService DashboardService

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]


<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    @* Titre Principal *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold;">Tableau de bord</MudText>
    </MudStack>

    @* Section Statistiques *@
    <MudGrid Class="mb-8">
        @* Carte Utilisateurs *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Nombre d'utilisateurs</MudText>
                <div style="position: relative; width: 140px; height: 140px;">
                    @* Taille augmentée ici *@
                    <MudProgressCircular Color="Color.Warning" Value="@model.total_users" Size="Size.Large" StrokeWidth="8" Style="height:140px; width:140px;" />
                    <MudText Typo="Typo.body1" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold; white-space: nowrap;">
                        @model.total_users
                    </MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Voiture la plus louée *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: bold;">Voiture la plus louée</MudText>

                @if (model.VoiturePlusLouee != null)
                {
                    <MudText Typo="Typo.body1"><b>@model.VoiturePlusLouee.Marque</b></MudText>
                    <MudText Typo="Typo.body2" Class="mb-2">@model.VoiturePlusLouee.Modele</MudText>

                    @if (!string.IsNullOrEmpty(model.VoiturePlusLouee.ImagePath))
                    {
                        <MudImage Src="@model.VoiturePlusLouee.ImagePath" Alt="Top Car" Elevation="0" ObjectFit="ObjectFit.Contain" Height="80" Class="mb-2" />
                    }

                    <MudText Typo="Typo.caption">Louée @model.VoiturePlusLouee.nb_locations fois</MudText>
                }
                else
                {
                    <MudProgressCircular Color="Color.Default" Indeterminate="true" Size="Size.Small" />
                }
            </MudCard>
        </MudItem>

        @* Carte Revenus mensuels *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Revenus mensuels</MudText>
                <div style="position: relative; width: 140px; height: 140px;">
                    @* Taille augmentée ici *@
                    <MudProgressCircular Color="Color.Warning" Value="15" Size="Size.Large" StrokeWidth="8" Style="height:140px; width:140px;" />
                    <MudText Typo="Typo.body1" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold; white-space: nowrap;">
                        @model.RevenusMensuels €
                    </MudText>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Section Listes *@
    <MudGrid>
        @* Colonne Rappel *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Rappel</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var rappel in model.Rappels)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText>@rappel.TypeAction – @rappel.Vehicule</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Colonne Planning *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Planning</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var p in model.Planning)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText><b>@p.Heure</b> – @p.Description</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    private DashboardModel model = new();

    protected override async Task OnInitializedAsync()
    {
        // On lance les appels en parallèle de manière sécurisée
        var tasks = new List<Task>
        {
            Task.Run(async () => { model.total_users = await DashboardService.GetTotalUsersAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.RevenusMensuels = await DashboardService.GetMonthlyRevenuesAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.VoiturePlusLouee = await DashboardService.GetMostRentedCarDetailsAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.Rappels = await DashboardService.GetRappelsAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.Planning = await DashboardService.GetPlanningAsync(); await InvokeAsync(StateHasChanged); })
        };

        await Task.WhenAll(tasks); //
    }
}