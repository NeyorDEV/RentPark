@page "/"
@using MudBlazor
@using MAlign = MudBlazor.Align

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    @* Titre Principal *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold;">Tableau de bord</MudText>
    </MudStack>

    @* Section Statistiques *@
    <MudGrid Class="mb-8">
        @* Carte Utilisateurs *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Nombre d'utilisateurs</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="@UserPercentage" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">@UserPercentage%</MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Voiture la plus louée *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Voiture la plus louée</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="@MostRentedPercentage" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">@MostRentedPercentage%</MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Revenus mensuels *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Revenus mensuels</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="@MonthlyRevenuePercentage" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">@MonthlyRevenuePercentage%</MudText>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Section Listes (Rappel et Planning) *@
    <MudGrid>
        @* Colonne Rappel *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Rappel</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var rappel in ListeRappels)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText>@rappel</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Colonne Planning *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Planning</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var item in ListePlanning)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText>@item</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>