@page "/"
@using MudBlazor
@using MAlign = MudBlazor.Align
@using System.Globalization

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    @* Titre Principal *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold;">Tableau de bord</MudText>
        <MudText Typo="Typo.subtitle2" Class="mud-text-right" Style="opacity:0.8;">
            <b>CurrentCulture</b> : @CultureInfo.CurrentCulture.Name
        </MudText>
    </MudStack>

    @* Section Statistiques (Graphiques Circulaires) *@
    <MudGrid Class="mb-8">
        @* Carte Utilisateurs *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Nombre d'utilisateurs</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="75" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">75%</MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Voiture la plus louée *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Voiture la plus louée</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="50" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">50%</MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Revenus mensuels *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Revenus mensuels</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="15" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">15%</MudText>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Section Listes (Rappel et Planning) *@
    <MudGrid>
        @* Colonne Rappel *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Rappel</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @* Liste des rappels factices *@
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>Contrôle technique – BMW Série 4</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>Vidange – Clio 3</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>Assurance – Tesla Model 3</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>Contrôle Pollution – Peugeot 208</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>Révision – Audi A3</MudText>
                        </MudPaper>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Colonne Planning *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Planning</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @* Liste du planning factice *@
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>09:00 – Location Peugeot 208</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>10:30 – Retour Tesla Model 3</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>13:00 – Location BMW Série 4</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>16:00 – Nettoyage Renault Twingo</MudText>
                        </MudPaper>
                        <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                            <MudText>18:00 – Clôture caisse</MudText>
                        </MudPaper>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>