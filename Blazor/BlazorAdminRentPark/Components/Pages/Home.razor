@page "/"
@using MudBlazor
@using MAlign = MudBlazor.Align
@using BlazorAdminRentPark.Models
@using BlazorAdminRentPark.Services
@inject IDashboardService DashboardService

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-8">

    @* Titre Principal *@
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight: bold;">Tableau de bord</MudText>
    </MudStack>

    @* Section Statistiques *@
    <MudGrid Class="mb-8">
        @* Carte Utilisateurs *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Nombre d'utilisateurs</MudText>
                <div style="position: relative;">
                    @* Ici on affiche la valeur du modèle qui sera mise à jour *@
                    <MudProgressCircular Color="Color.Warning" Value="@model.NombreUtilisateurs" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">
                        @model.NombreUtilisateurs
                    </MudText>
                </div>
            </MudCard>
        </MudItem>

        @* Carte Voiture la plus louée (Image dynamique) *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-2" Style="font-weight: bold;">Voiture la plus louée</MudText>
                @if (!string.IsNullOrEmpty(model.ImageVoiturePlusLouee))
                {
                    <MudImage Src="@model.ImageVoiturePlusLouee" Alt="Top Car" Elevation="0" ObjectFit="ObjectFit.Contain" Height="80" Class="mb-2" />
                }
                <MudProgressLinear Color="Color.Warning" Value="50" Class="my-2" />
            </MudCard>
        </MudItem>

        @* Carte Revenus mensuels *@
        <MudItem xs="12" md="4">
            <MudCard Elevation="3" Class="rounded-lg pa-4 d-flex flex-column align-center justify-center" Style="height: 100%;">
                <MudText Typo="Typo.h6" Class="mb-4" Style="font-weight: bold;">Revenus mensuels</MudText>
                <div style="position: relative;">
                    <MudProgressCircular Color="Color.Warning" Value="15" Size="Size.Large" StrokeWidth="8" Style="height:120px; width:120px;" />
                    <MudText Typo="Typo.h6" Style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); font-weight: bold;">
                        @model.RevenusMensuels €
                    </MudText>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    @* Section Listes *@
    <MudGrid>
        @* Colonne Rappel *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Rappel</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var rappel in model.Rappels)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText>@rappel.TypeAction – @rappel.Vehicule</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>

        @* Colonne Planning *@
        <MudItem xs="12" md="6">
            <MudCard Elevation="3" Class="rounded-lg">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6" Align="MAlign.Center" Style="font-weight: bold;">Planning</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="height: 300px; overflow-y: auto;">
                    <MudStack Spacing="2">
                        @foreach (var p in model.Planning)
                        {
                            <MudPaper Elevation="0" Class="pa-3 rounded" Style="background-color: #f2ebeb;">
                                <MudText><b>@p.Heure</b> – @p.Description</MudText>
                            </MudPaper>
                        }
                    </MudStack>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

</MudContainer>

@code {
    private DashboardModel model = new();

    protected override async Task OnInitializedAsync()
    {
        // On lance les appels en parallèle de manière sécurisée
        var tasks = new List<Task>
        {
            Task.Run(async () => { model.NombreUtilisateurs = await DashboardService.GetTotalUsersAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.RevenusMensuels = await DashboardService.GetMonthlyRevenuesAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.ImageVoiturePlusLouee = await DashboardService.GetMostRentedCarImageAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.Rappels = await DashboardService.GetRappelsAsync(); await InvokeAsync(StateHasChanged); }),
            Task.Run(async () => { model.Planning = await DashboardService.GetPlanningAsync(); await InvokeAsync(StateHasChanged); })
        };

        await Task.WhenAll(tasks); //
    }
}