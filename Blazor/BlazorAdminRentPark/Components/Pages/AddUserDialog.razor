@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">Ajouter un Utilisateur</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="4" Class="pa-4">
                <MudTextField @bind-Value="_userModel.Username"
                              Label="Nom d'utilisateur"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Le nom d'utilisateur est obligatoire" />

                <MudTextField @bind-Value="_userModel.Password"
                              Label="Mot de passe"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Le mot de passe est obligatoire" />

                <MudSelect @bind-Value="_userModel.Role"
                           Label="Rôle"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="Le rôle est obligatoire">
                    <MudSelectItem Value="@("admin")">Admin</MudSelectItem>
                    <MudSelectItem Value="@("employe")">Employé</MudSelectItem>
                    <MudSelectItem Value="@("client")">Client</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="HandleSubmit"
                   FullWidth="true"
                   Style="max-width: 200px; margin: 0 auto 20px auto;"
                   Disabled="@(!_isValid)">
            Ajouter
        </MudButton>
    </DialogActions>
</MudDialog>