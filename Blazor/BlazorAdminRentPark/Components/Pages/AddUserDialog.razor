@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">Ajouter un Utilisateur</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4" Class="pa-4">
            <MudTextField T="string" Label="username" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="password" InputType="InputType.Password" Variant="Variant.Outlined" />
            <MudTextField T="string" Label="confirm" InputType="InputType.Password" Variant="Variant.Outlined" />
            <MudSelect T="string" Label="role" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("admin")">Admin</MudSelectItem>
                <MudSelectItem Value="@("collaborateur")">Collaborateur</MudSelectItem>
                <MudSelectItem Value="@("client")">Client</MudSelectItem>
            </MudSelect>
        </MudStack>
    </DialogContent>
    <DialogActions>
        @* On utilise une méthode générique de fermeture si l'instance pose problème *@
        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="Cancel" FullWidth="true" Style="max-width: 200px; margin: 0 auto 20px auto;">Ajouter</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private dynamic? MudDialog { get; set; } // Utiliser dynamic permet de passer outre l'erreur de compilation du type

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}