@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<MudDialog>
    <TitleContent>
        @* Titre dynamique *@
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">
            @(IsEditMode ? "Modifier un Utilisateur" : "Ajouter un Utilisateur")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="4" Class="pa-4">

                @* Champ Username *@
                <MudTextField @bind-Value="_userModel.Username"
                              Label="Nom d'utilisateur"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="Le nom d'utilisateur est obligatoire" />

                @* Champ Password : Required est false si on est en mode édition *@
                <MudTextField @bind-Value="_userModel.Password"
                              Label="Mot de passe"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="@(!IsEditMode)"
                              RequiredError="Le mot de passe est obligatoire"
                              HelperText="@(IsEditMode ? "Laisser vide pour conserver le mot de passe actuel" : null)" />

                @* Champ Rôle *@
                <MudSelect @bind-Value="_userModel.Role"
                           Label="Rôle"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="Le rôle est obligatoire">
                    <MudSelectItem Value="@("admin")">Admin</MudSelectItem>
                    <MudSelectItem Value="@("employe")">Employé</MudSelectItem>
                    <MudSelectItem Value="@("client")">Client</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="HandleSubmit"
                   FullWidth="true"
                   Style="max-width: 200px; margin: 0 auto 20px auto;"
                   Disabled="@(!_isValid)">
            @(IsEditMode ? "Modifier" : "Ajouter")
        </MudButton>
    </DialogActions>
</MudDialog>