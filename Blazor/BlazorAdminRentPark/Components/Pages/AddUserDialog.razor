@using MudBlazor
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<MudDialog>
    <TitleContent>
        @* Titre dynamique *@
        <MudText Typo="Typo.h5" Align="Align.Center" Style="font-weight: bold;">
            @(IsEditMode ? @Localizer["Edit"] : @Localizer["Add"])
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudStack Spacing="4" Class="pa-4">

                @* Champ Username *@
                <MudTextField @bind-Value="_userModel.Username"
                              Label="@Localizer["Username"]"
                              Variant="Variant.Outlined"
                              Required="true"
                              RequiredError="@Localizer["UsernameObligatoire"]" />

                @* Champ Password : Required est false si on est en mode édition *@
                <MudTextField @bind-Value="_userModel.Password"
                              Label="@Localizer["pass"]"
                              InputType="InputType.Password"
                              Variant="Variant.Outlined"
                              Required="@(!IsEditMode)"
                              RequiredError="@Localizer["passObligatoire"]"
                              HelperText="@(IsEditMode ? @Localizer["passInfo"] : null)" />


                @* Champ Rôle *@
                <MudSelect @bind-Value="_userModel.Role"
                           Label="@Localizer["Role"]"
                           Variant="Variant.Outlined"
                           AnchorOrigin="Origin.BottomCenter"
                           Required="true"
                           RequiredError="@Localizer["RoleObligatoire"]">
                    <MudSelectItem Value="@("admin")">@Localizer["Admin"]</MudSelectItem>
                    <MudSelectItem Value="@("employe")">@Localizer["Employe"]</MudSelectItem>
                    <MudSelectItem Value="@("client")">@Localizer["Client"]</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Success"
                   Variant="Variant.Filled"
                   OnClick="HandleSubmit"
                   FullWidth="true"
                   Style="max-width: 200px; margin: 0 auto 20px auto;"
                   Disabled="@(!_isValid)">

            @(IsEditMode ? @Localizer["Modifier"] : @Localizer["Ajouter"])

        </MudButton>
    </DialogActions>
</MudDialog>