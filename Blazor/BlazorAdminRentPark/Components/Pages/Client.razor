@page "/client"

<h3>Liste des Clients</h3>

@if (clients == null)
{
    <p><em>Chargement...</em></p>
}
else if (!clients.Any())
{
    <p><em>Aucun client trouvé.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Prénom</th>
                <th>Nom</th>
                <th>DateNaiss</th>
                <th>Nationalite</th>
                <th>NumTel</th>
                <th>Email</th>
                <th>NumPermis</th>
                <th>Commentaire</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var client in clients)
            {
                <tr>
                    <td>@client.IdClient</td>
                    <td>@client.Prenom</td>
                    <td>@client.Nom</td>
                    <td>@client.DateNaiss.ToShortDateString()</td>
                    <td>@client.Nationalite</td>
                    <td>@client.NumTel</td>
                    <td>@client.Email</td>
                    <td>@client.NumPermis</td>
                    <td>@client.Commentaire</td>
                    <td>
                        <button class="btn btn-danger btn-sm" @onclick="() => DeleteClient(client.IdClient)">
                            Supprimer
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}