{% extends "base.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" href="/siteSAE2A/html/css/flotte.css">
{% endblock %}

{% block content %}
<div class="main-content">
    <div class="header-container"> 
        <h1>Flotte Automobile</h1>
        {% if role == 'admin' or role == 'employe' %}
            <a href="#addModal" class="add-btn-main">
                <i class="fa-solid fa-plus"></i> Ajouter un véhicule
            </a>
        {% endif %}
    </div>

    <header class="search-section">
        <form action="/sitesae2A/voitures" method="get" class="search-form">
            <input type="hidden" name="action" value="rechercherVoitures">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input name="q" type="search" placeholder="Rechercher un modèle..." value="{{ app.request.get('q')|default('') }}">
            </div>
        </form>
    </header>

    {% if dVueErreur is not empty %}
    <div class="erreurs">
        <ul>
            {% for erreur in dVueErreur %}
                <li>{{ erreur|e }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <div class="voiture-grid-container">
        {% if results is not empty %}
            {% for row in results %}
                <div class="rectangle-card" onclick="location.href='/siteSAE2A/voiture/{{ row.voiture|e }}'">
                    <img src="{{ row.ImagePath is not empty ? row.ImagePath|e : 'html/icons/voiture.png' }}" 
                         alt="{{ row.Nom|e }}" class="bg-img">

                    <div class="info-glass">
                        <h2>{{ row.Nom|e }}</h2>
                        <div class="badges">
                            <span class="badge">{{ row.Puissance|e }} cv</span>
                        </div>
                        
                        {% if role == 'admin' or role == 'employe' %}
                        <div class="actions-admin" onclick="event.stopPropagation();">
                            <a href="#editModal-{{ row.voiture|e }}" class="btn-icon-glass edit">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form method="POST" action="/siteSAE2A/voitures" onsubmit="return confirm('Supprimer ce véhicule ?');" style="display:inline;">
                                <input type="hidden" name="action" value="supprimerVoiture">
                                <input type="hidden" name="NumSerie" value="{{ row.NumSerie|e }}">
                                <button type="submit" class="btn-icon-glass delete"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                        {% endif %}
                    </div>
                </div>

                {# Modales de modification #}
                {% if role == 'admin' or role == 'employe' %}
                <div id="editModal-{{ row.voiture|e }}" class="modal" onclick="event.stopPropagation();">
                    <div class="modal-content glass-container">
                            <a href="#" class="close">&times;</a>
                            <h2>Modifier le véhicule</h2>
                            <form method="POST" action="/siteSAE2A/voitures" enctype="multipart/form-data">
                                <input type="hidden" name="action" value="modifierVoiture">
                                <input type="hidden" name="id" value="{{ row.voiture|e }}">
                                
                                <div class="form-group">
                                    <label for="modele-{{ row.voiture|e }}">Modèle du véhicule</label>
                                    <input type="text" id="modele-{{ row.voiture|e }}" name="modele" required value="{{ row.modele|e }}">
                                </div>
                                
                                <div class="form-group">
                                    <label for="puissance-{{ row.voiture|e }}">Puissance (en cv)</label>
                                    <input type="number" id="puissance-{{ row.voiture|e }}" name="puissance" required value="{{ row.puissance|e }}">
                                </div>
                                
                                <div class="form-group">
                                    <label for="couleur-{{ row.voiture|e }}">Couleur</label>
                                    <input type="text" id="couleur-{{ row.voiture|e }}" name="couleur" required value="{{ row.couleur|e }}">
                                </div>
                                
                                <div class="form-group">
                                    <label>Image actuelle ou nouvelle</label>
                                    <input type="file" name="image" accept="image/*">
                                </div>
                                
                                <button type="submit" class="save-btn">Mettre à jour</button>
                            </form>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        {% else %}
            <p>Aucun véhicule trouvé</p>
        {% endif %}
    </div>
</div>

{# Modale d'ajout #}
{% if role == 'admin' or role == 'employe' %}
{# MODALE D'AJOUT #}
<div id="addModal" class="modal">
    <div class="modal-content glass-container">
        <a href="#" class="close">&times;</a>
        <h2>Nouveau véhicule</h2>
        <form method="POST" action="/siteSAE2A/voitures" enctype="multipart/form-data">
            <input type="hidden" name="action" value="ajouterVoiture">
        
            <div class="form-group">
                <label>Numéro de série</label>
                <input type="text" name="NumSerie" required>
            </div>
        
            <!-- Marque -->
            <div class="form-group">
                <label>Marque</label>
                <select name="Marque" id="marque" required>
                    <option value="">-- Marque --</option>
                    <option value="Renault">Renault</option>
                    <option value="Peugeot">Peugeot</option>
                    <option value="Citroen">Citroën</option>
                    <option value="Tesla">Tesla</option>
                </select>
            </div>
        
            <!-- Modèle -->
            <div class="form-group">
                <label>Nom du modèle</label>
                <select name="Nom" id="modele" required>
                    <option value="">-- Modèle --</option>
                </select>
                <input type="text"
                       name="NouveauModele"
                       id="nouveauModele"
                       placeholder="Nouveau modèle"
                       style="display:none; margin-top:5px;">
            </div>
        
            <div class="form-group">
                <label>Année</label>
                <input type="number" name="Annee" min="1990" max="2026" required>
            </div>
        
            <!-- Énergie -->
            <div class="form-group">
                <label>Énergie</label>
                <select name="Energie" required>
                    <option value="">-- Énergie --</option>
                    <option value="Essence">Essence</option>
                    <option value="Diesel">Diesel</option>
                    <option value="Electrique">Électrique</option>
                    <option value="Hybride">Hybride</option>
                </select>
            </div>
        
            <div class="form-group">
                <label>Puissance (ch)</label>
                <input type="number" name="Puissance" min="50" max="1000">
            </div>
        
            <div class="form-group">
                <label>Nombre de places</label>
                <input type="number" name="NbPlaces" min="2" max="9" required>
            </div>
        
            <!-- Catégorie -->
            <div class="form-group">
                <label>Catégorie</label>
                <select name="Categorie" required>
                    <option value="">-- Catégorie --</option>
                    <option value="Citadine">Citadine</option>
                    <option value="Berline">Berline</option>
                    <option value="SUV">SUV</option>
                    <option value="Utilitaire">Utilitaire</option>
                </select>
            </div>
        
            <!-- Transmission -->
            <div class="form-group">
                <label>Transmission</label>
                <select name="Transmission">
                    <option value="Traction">Traction</option>
                    <option value="Propulsion">Propulsion</option>
                    <option value="Integrale">Intégrale</option>
                </select>
            </div>
        
            <!-- Boîte -->
            <div class="form-group">
                <label>Boîte</label>
                <select name="Boite" required>
                    <option value="Manuelle">Manuelle</option>
                    <option value="Automatique">Automatique</option>
                </select>
            </div>
        
            <!-- État -->
            <div class="form-group">
                <label>État</label>
                <select name="Etat" required>
                    <option value="Libre">Libre</option>
                    <option value="Loué">Loué</option>
                    <option value="Maintenance">Maintenance</option>
                </select>
            </div>
        
            <div class="form-group">
                <label>Date d'achat</label>
                <input type="date" name="DateAchat" required>
            </div>
        
            <div class="form-group">
                <label>Date dernier contrôle technique</label>
                <input type="date" name="DateDernierControleTech">
            </div>
        
            <div class="form-group">
                <label>Date expiration contrôle technique</label>
                <input type="date" name="DateExpirationControleTech">
            </div>
        
            <div class="form-group">
                <label>Couleur</label>
                <input type="text" name="Couleur">
            </div>
        
            <div class="form-group">
                <label>Prix (€)</label>
                <input type="number" step="0.01" name="Prix" min="100" max="100000" required>
            </div>
        
            <div class="form-group">
                <label>Assureur (ID)</label>
                <input type="number" name="IdAssureur" required>
            </div>
        
            <div class="form-group">
                <label>Fournisseur (ID)</label>
                <input type="number" name="IdFournisseur" required>
            </div>
        
            <div class="form-group">
                <label>Photo du véhicule</label>
                <input type="file" name="ImagePath" accept="image/*">
            </div>
        
            <button type="submit" class="save-btn">Ajouter le véhicule</button>
        </form>
               
    </div>
</div>
{% endif %}
{% endblock %}