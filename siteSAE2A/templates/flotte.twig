{% extends "base.twig" %}

{% block stylesheets %}
    <link rel="stylesheet" href="/siteSAE2A/html/css/flotte.css">
{% endblock %}

{% block content %}
<div class="main-content">
    <div class="header-container"> 
        <h1>Flotte Automobile</h1>
        {% if role == 'admin' %}
            <a href="#addModal" class="add-btn-main">
                <i class="fa-solid fa-plus"></i> Ajouter un véhicule
            </a>
        {% endif %}
    </div>

    <header class="search-section">
        <form action="/sitesae2A/voitures" method="get" class="search-form">
            <input type="hidden" name="action" value="rechercherVoitures">
            <div class="search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input name="q" type="search" placeholder="Rechercher un modèle..." value="{{ app.request.get('q')|default('') }}">
            </div>
        </form>
    </header>

    <div class="voitures-grid">
        {% if results is not empty %}
            {% for row in results %}
                <div class="car-card clickable-card" onclick="location.href='/siteSAE2A/voiture/{{ row.voiture|e }}'">
                    <div class="car-image">
                        <img src="{{ row.ImagePath is not empty ? row.ImagePath|e : 'html/icons/voiture.png' }}" alt="{{ row.Nom|e }}">
                    </div>
                    <div class="car-content">
                        <h2>{{ row.Nom|e }}</h2>
                        <div class="car-badges">
                            <span class="badge">{{ row.Puissance|e }} cv</span>
                            <span class="badge">{{ row.couleur|e }}</span>
                        </div>
                        
                        {% if role == 'admin' %}
                        <div class="car-admin-actions" onclick="event.stopPropagation();">
                            <a href="#editModal-{{ row.voiture|e }}" class="btn-icon edit" title="Modifier">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <form method="POST" action="/siteSAE2A/voitures" class="delete-form" onsubmit="return confirm('Supprimer ce véhicule ?');" style="display:inline;">
                                <input type="hidden" name="action" value="supprimerVoiture">
                                <input type="hidden" name="id" value="{{ row.voiture|e }}">
                                <button type="submit" class="btn-icon delete"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                        {% endif %}
                    </div>
                </div>

                {# MODALE DE MODIFICATION (Une par voiture) #}
                {% if role == 'admin' %}
                <div id="editModal-{{ row.voiture|e }}" class="modal" onclick="event.stopPropagation();">
                    <div class="modal-content glass-container">
                        <a href="#" class="close">&times;</a>
                        <h2>Modifier {{ row.Nom|e }}</h2>
                        <form method="POST" action="/siteSAE2A/voitures" enctype="multipart/form-data">
                            <input type="hidden" name="action" value="modifierVoiture">
                            <input type="hidden" name="id" value="{{ row.voiture|e }}">
                            
                            <div class="form-group">
                                <label>Modèle</label>
                                <input type="text" name="modele" required value="{{ row.modele|e }}">
                            </div>
                            <div class="form-group">
                                <label>Puissance (cv)</label>
                                <input type="number" name="puissance" required value="{{ row.puissance|e }}">
                            </div>
                            <div class="form-group">
                                <label>Couleur</label>
                                <input type="text" name="couleur" required value="{{ row.couleur|e }}">
                            </div>
                            <div class="form-group">
                                <label>Image du véhicule</label>
                                <input type="file" name="image" accept="image/*">
                            </div>
                            <button type="submit" class="save-btn">Enregistrer les modifications</button>
                        </form>
                    </div>
                </div>
                {% endif %}
            {% endfor %}
        {% else %}
            <div class="no-results">
                <p>Aucun véhicule trouvé</p>
            </div>
        {% endif %}
    </div>
</div>

{# MODALE D'AJOUT #}
{% if role == 'admin' %}
<div id="addModal" class="modal">
    <div class="modal-content glass-container">
        <a href="#" class="close">&times;</a>
        <h2>Nouveau véhicule</h2>
        <form method="POST" action="/siteSAE2A/voitures" enctype="multipart/form-data">
            <input type="hidden" name="action" value="ajouterVoiture">
            <div class="form-group">
                <input type="text" name="modele" placeholder="Modèle (ex: Tesla Model 3)" required>
            </div>
            <div class="form-group">
                <input type="number" name="puissance" placeholder="Puissance (cv)" required>
            </div>
            <div class="form-group">
                <input type="text" name="couleur" placeholder="Couleur" required>
            </div>
            <div class="form-group">
                <label style="font-size: 0.8rem; color: #666;">Image du véhicule</label>
                <input type="file" name="image" accept="image/*">
            </div>
            <button type="submit" class="save-btn">Ajouter à la flotte</button>
        </form>
    </div>
</div>
{% endif %}
{% endblock %}