@startuml

' ============================
'        FRONT CONTROLLER
' ============================

class FrontControleur {

    -router: AltoRouter
    -adminController: Controller
    -userController: Controller

    +__construct(router: AltoRouter, adminController: Controller, userController: Controller)
    +run(): void
}

FrontControleur --> AltoRouter      : "utilise"
FrontControleur --> AdminControleur : "appelle"
FrontControleur --> CollabController: "appelle"
FrontControleur --> UserController  : "appelle"
FrontControleur --> GuestController : "appelle"


' ============================
'           TECHNIQUE
' ============================

class Connection {

    -stmt: PDOStatement

    +__construct(dsn: string, username: string, password: string)
    +executeQuery(query: string, parameters: array): bool
    +getResults(): array
}

class AltoRouter {

    -routes: array
    -namedRoutes: array
    -basePath: string
    -matchTypes: array

    +__construct(routes: array, basePath: string, matchTypes: array)
    +getRoutes(): array
    +addRoutes(routes: array): void
    +setBasePath(basePath: string): void
    +addMatchTypes(matchTypes: array): void
    +map(method: string, route: string, target: mixed, name: string): void
    +generate(routeName: string, params: array): string
    +match(requestUrl: string, requestMethod: string): array | boolean
    +compileRoute(route: string): string
}


' ============================
'            MODELES
' ============================

class Reservation {

    -idContrat: int
    -dateDebut: DateTime
    -dateFin: DateTime
    -vehiculeId: int
    -clientId: int
    -etatDesLieuxId: int

    +__construct(idContrat: int, dateDebut: DateTime, dateFin: DateTime,
                 vehiculeId: int, clientId: int, etatDesLieuxId: int)
    +getIdContrat(): int
    +getDateDebut(): DateTime
    +getDateFin(): DateTime
    +getVehiculeId(): int
    +getClientId(): int
    +getEtatDesLieuxId(): int
}

class User {

    -id: int
    -username: string
    -passwordHash: string
    -role: string

    +__construct(id: int, username: string, passwordHash: string, role: string)
    +getId(): int
    +getUsername(): string
    +getPasswordHash(): string
    +getRole(): string
}

abstract class Vehicule {

    -id: int
    -modele: string
    -couleur: string
    -puissance: string
    
    +__construct(id: int, modele: string, couleur: string, puissance: string)
    +getId(): int
    +getModele(): string
    +getCouleur(): string
    +getPuissance(): string
    +__toString(): string
}

class Voiture extends Vehicule {
    
    -nbPortes: int   
    
    +getnbPortes(): int
}

Vehicule "1" <-- "0..*" Reservation : "concerne"
User     "1" <-- "0..*" Reservation : "concerne"


' ============================
'           GATEWAYS
' ============================

class ReservationGateway {

    -connection: Connection

    +__construct(connection: Connection)
    +searchReservations(champ: string, q: string, filtre: string): Reservation[]
    +insertReservation(reservation: Reservation): void
    +update(reservation: Reservation): void
    +delete(id: int): void
}

class UserGateway {

    -connection: Connection

    +__construct(connection: Connection)
    +login(user: User): void
    +addUser(user: User): void
    +getHashPass(username: string): string
    +getRole(username: string): string
    +deleteUser(id: int): void
    +getAllUser(): User[]
    +rechercherUtilisateur(motCle: string): User[]
    +update(user: User): void
}

class VehicleGateway {

    -connection: Connection

    +__construct(connection: Connection)
    +getAll(): Vehicule[]
    +add(voiture: Vehicule): void
    +delete(id: int): void
    +update(voiture: Vehicule): void
    +rechercherVehicules(motCle: string): Vehicule[]
}

UserGateway       ..> User       : "créer/envoie/modif/supp"
VehicleGateway    ..> Vehicule   : "créer/envoie/modif/supp"
ReservationGateway..> Reservation: "créer/envoie/modif/supp"

UserGateway        --> Connection: "utilise"
VehicleGateway     --> Connection: "utilise"
ReservationGateway --> Connection: "utilise"


' ============================
'          CONTROLEURS
' ============================

class AdminControleur extends CollabController {
}

class CollabController extends UserController {

    -DashboardService: IDashboardService
    +ConstructionServiceDashboard(dVueEreur: array): void
}

class UserController extends GuestController {

}

class GuestController {
    -ConnectionService : IConnectionService
    -vehicleService: IVehicleService
    -userService: IUserService
    -reservationService: IReservationService

    +__construct(vehicleService: IVehicleService,
                 userService: IUserService,
                 reservationService: IReservationService)
    +ConstructionServiceVehicule(dVueEreur: array): void
    +ConstructionServiceReservation(dVueEreur: array): void  
    +ConstructionServiceConnection(dVueEreur: array): void  
    +afficherVue(vueKey: string, dVueEreur: array, results: array, role: string): void       
}

GuestController --> IVehicleService     : "utilise"
GuestController --> IUserService        : "utilise"
GuestController --> IReservationService : "utilise"
CollabController --> IDashboardService  : "utilise"


' ============================
'            SERVICES
' ============================

interface IVehicleService {
    +getAll(): array<JSON>
    +getById(id: int): array<JSON>
    +create(modele: string, couleur: string, puissance: string): array<JSON>
    +update(id: int, modele: string, couleur: string, puissance: string): array<JSON>
    +delete(id: int): void
}

class VehicleService implements IVehicleService {
    -vehicleGateway: VehicleGateway
    -validator: IVehicleValidator
    +__construct(vehicleGateway: VehicleGateway, validator: IVehicleValidator)
}

interface IConnectionService {

    +login(username: string, password: string): array<JSON>
    +logout(): void
    +register(username: string, password: string, role: string): array<JSON>
    +isLoggedIn(): bool
    +getCurrentUser(): array<JSON>
}

class ConnectionService implements IConnectionService {
    -userService: IUserService
    -validator: IUserValidator
    +__construct(userService: IUserService, validator: IUserValidator)
}


interface IUserService {
    +getAll(): array<JSON>
    +getById(id: int): array<JSON>
    +add(username: string, password: string, role: string): array<JSON>
    +delete(id: int): void
    +update(id:int, username: string, password: string, role: string):void
}

class UserService implements IUserService {
    -userGateway: UserGateway
    -validator: IUserValidator
    +__construct(userGateway: UserGateway, validator: IUserValidator)
}

interface IReservationService {
    +getAll(): array<JSON>
    +getById(idContrat: int): array<JSON>
    +create(vehiculeId: int, clientId: int, dateDebut: DateTime, dateFin: DateTime): array<JSON>
    +update(idContrat: int, vehiculeId: int, clientId: int, dateDebut: DateTime, dateFin: DateTime): array<JSON>
    +cancel(idContrat: int): void
}

class ReservationService implements IReservationService {

    -reservationGateway: ReservationGateway
    -vehicleGateway: VehicleGateway
    -userGateway: UserGateway
    -validator: IReservationValidator

    +__construct(reservationGateway: ReservationGateway,
                 vehicleGateway: VehicleGateway,
                 userGateway: UserGateway,
                 validator: IReservationValidator)
}

interface IDashboardService {
    +getStats(): array
}

class DashboardService implements IDashboardService {
}

VehicleService     --> VehicleGateway
UserService        --> UserGateway
ReservationService --> ReservationGateway
ReservationService --> VehicleGateway
ReservationService --> UserGateway

ReservationService --> Reservation : "manipule"
VehicleService     --> Vehicule    : "manipule"
UserService        --> User        : "manipule"


' ============================
'           VALIDATION
' ============================

interface IUserValidator {

    +validateRegistration(username: string, password: string, confirm: string, role: string, dVueEreur: array): void
    +validateLogin(username: string, password: string, dVueEreur: array): bool
}

interface IVehicleValidator {

    +validateVehicle(modele: string, couleur: string, puissance: int): void
}

interface IReservationValidator {

    +validateReservation(vehiculeId: int, clientId: int, dateDebut: DateTime, dateFin: DateTime, dVueEreur: array): void
}

class UserValidator implements IUserValidator {

}

class VehicleValidator implements IVehicleValidator {

}

class ReservationValidator implements IReservationValidator {

}

'pas propre ...

VehicleService     --> IVehicleValidator     : "valide données véhicule"
UserService        --> IUserValidator        : "valide données utilisateur"
ReservationService --> IReservationValidator : "valide données réservation"


GuestController --> IConnectionService : "authentifie"
UserController  --> IConnectionService : "gère session"
CollabController --> IConnectionService
AdminControleur --> IConnectionService

ConnectionService --> IUserService     : "utilise pour accès BDD"
ConnectionService --> IUserValidator   : "valide données login/register"

@enduml
